PORT=5000
NODE_ENV=development

# For Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/profile_management_system

# For Web MongoDB Atlas Cloud Cluster:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/profile_management_system?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_key_here
CLIENT_ORIGIN=http://localhost:5173
