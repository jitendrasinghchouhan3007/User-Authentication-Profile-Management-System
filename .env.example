# =============================================================
# User Authentication & Profile Management System
# Root Environment Variables Example
# =============================================================
# Copy this file and rename to .env (if using a monorepo .env)
# Or configure each sub-project's .env separately (recommended)
# =============================================================

# --- Backend (backend/.env) ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/profile_management_system
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/profile_management_system?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here_change_in_production
CLIENT_ORIGIN=http://localhost:5173

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:5000
